                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Username and password generated\", function () {",
                  "    pm.expect(body.username).to.not.be.empty;",
                  "    pm.expect(body.password).to.not.be.empty;",
                  "});",
                  "pm.environment.set(\"traineeUsername\", body.username);",
                  "pm.environment.set(\"traineePassword\", body.password);"
